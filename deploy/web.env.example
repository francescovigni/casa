# Runtime secrets for the site container. Copy to the host, chmod 600, edit,
# and turn it into a Secret:
#
#   kubectl create secret generic web-env --from-env-file=/root/web.env \
#     --dry-run=client -o yaml | kubectl apply -f -
#   helm upgrade --install web ./deploy/helm --set existingSecret=web-env ...
#
# After changing a value, re-apply as above and restart the pods:
#   kubectl rollout restart deploy/web-francescovigni-web
#
# This file is an example. Real values belong on the host only: .env* is
# gitignored.

# Enables the email fallback for leads. Without it a submitted form still
# answers {"ok":true} and the lead exists only in the container logs.
SMTP_URL=

# Twenty CRM. While the token is empty or "changeme" the CRM is skipped and
# leads take the email path.
TWENTY_API_URL=
TWENTY_API_TOKEN=changeme
