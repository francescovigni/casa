---
// Three named ways to start, in ascending commitment, named after what the
// client gets rather than after a phase of a methodology. No durations: the
// audit is explicit that a published week range has to match real offers.
import { type Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t =
  locale === "it"
    ? {
        // Written for a company owner, not an ML team: the Italian pages
        // sell to SMEs, so the steps say what happens to their process.
        kicker: "Come si comincia",
        title: "Tre passi. Puoi fermarti dopo ognuno.",
        formats: [
          {
            name: "Analisi del processo",
            body: "Capisco cosa fate oggi, che dati avete e dove l'AI può far risparmiare tempo o errori. Ne esce una raccomandazione chiara, anche quando è: non conviene.",
          },
          {
            name: "Prototipo sui tuoi dati",
            body: "Costruisco una prima versione su documenti, immagini o dati veri e misuro quanto funziona. Decidi se andare avanti guardando i numeri, non una demo.",
          },
          {
            name: "Messa in produzione e supporto",
            body: "Il sistema entra nel lavoro di tutti i giorni, collegato ai tuoi strumenti. Poi lo seguo: aggiornamenti, controlli e correzioni quando i dati cambiano.",
          },
        ],
      }
    : {
        kicker: "How this starts",
        title: "Three ways to work together.",
        formats: [
          {
            name: "Technical audit",
            body: "Feasibility questions, existing ML pipelines, model failure investigation, architecture review, evaluation design.",
          },
          {
            name: "Proof of concept",
            body: "Model prototyping, computer vision, medical imaging, edge AI, research-to-product validation.",
          },
          {
            name: "Ongoing technical support",
            body: "Fractional senior ML expertise, architecture guidance, research and engineering support, production transition.",
          },
        ],
      };
---

<section class="wrap pb-16 sm:pb-20">
  <div class="border-t border-line pt-10">
    <p class="kicker mb-3">{t.kicker}</p>
    <h2 class="display mb-8 max-w-prose text-2xl">{t.title}</h2>
    <ol class="grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-3">
      {
        t.formats.map((format, i) => (
          <li class="bg-canvas p-6" data-reveal style={`--reveal-delay:${i}`}>
            <h3 class="font-sans text-base font-semibold text-ink">{format.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{format.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
