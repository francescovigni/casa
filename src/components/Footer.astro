---
import { type Locale } from "../i18n";
import { SITE } from "../data/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = 2026;
const privacyHref = locale === "it" ? "/it/privacy/" : "/privacy/";
// "Portfolio" first: it is the only entry that is work rather than a profile.
const links = [
  { href: SITE.portfolio, label: "Portfolio" },
  { href: SITE.profiles.scholar, label: "Google Scholar" },
  { href: SITE.profiles.linkedin, label: "LinkedIn" },
  { href: SITE.profiles.github, label: "GitHub" },
  { href: SITE.profiles.orcid, label: "ORCID" },
];
---

<footer class="mt-24 border-t border-line">
  <div class="wrap flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div class="text-sm text-faint">
      <p class="font-serif text-base text-ink">Francesco Vigni, PhD</p>
      <p class="mt-1">
        © {year} ·
        <a href={privacyHref} class="underline-offset-2 hover:underline">Privacy</a>
        ·
        <button type="button" data-consent-open class="underline-offset-2 hover:underline">
          {locale === "it" ? "Preferenze privacy" : "Privacy settings"}
        </button>
        ·
        <a href="mailto:hello@francescovigni.com" class="underline-offset-2 hover:underline"
          >hello@francescovigni.com</a
        >
      </p>
      {/* Italian law wants the VAT number on the site and the public-funding
          disclosure (L. 124/2017) one click away; both were on the Gatsby site. */}
      <p class="mt-1">
        P.IVA {SITE.vat} ·
        <a href="/it/trasparenza/" class="underline-offset-2 hover:underline">Trasparenza</a>
      </p>
    </div>
    <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Elsewhere">
      {
        links.map((l) => (
          <a
            href={l.href}
            rel="me noopener"
            target="_blank"
            class="link-underline text-muted transition-colors hover:text-ink"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
