---
import { pick, type Locale } from "../i18n";
import { trust } from "../data/home";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="border-t border-line bg-sand">
  <div class="wrap flex flex-col gap-5 py-10 sm:flex-row sm:items-center sm:justify-between">
    <p class="kicker shrink-0">{pick(trust.kicker, locale)}</p>
    <ul class="flex flex-wrap gap-2.5">
      {
        trust.badges.map((b) => (
          <li class="rounded border border-line bg-canvas px-3 py-1.5 text-xs font-medium text-muted">
            {pick(b, locale)}
          </li>
        ))
      }
    </ul>
  </div>
</section>
