---
// Plain <details> list: questions a buyer asks before writing. No FAQPage
// schema, Google no longer shows FAQ rich results for a site like this one.
import type { FaqItem } from "../data/services";

interface Props {
  items: FaqItem[];
  title?: string;
}
const { items, title = "Domande frequenti" } = Astro.props;
---

<section class="wrap py-16 sm:py-20">
  <h2 class="display mb-8 max-w-prose text-2xl sm:text-3xl">{title}</h2>
  <div class="max-w-prose divide-y divide-line border-y border-line">
    {
      items.map((item) => (
        <details class="group py-4">
          <summary class="cursor-pointer font-sans text-base font-semibold text-ink">
            {item.q}
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">{item.a}</p>
          {item.more && (
            <p class="mt-2 text-sm font-semibold">
              <a href={item.more.href} class="text-accent underline-offset-4 hover:underline">
                {item.more.label} <span aria-hidden="true">&rarr;</span>
              </a>
            </p>
          )}
        </details>
      ))
    }
  </div>
</section>
