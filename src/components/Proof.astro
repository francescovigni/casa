---
import { pick, type Locale } from "../i18n";
import { projects } from "../data/projects";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
// Picked by slug rather than sliced, so the three strongest proof points are
// the ones on the homepage: 5M+ frames, real-time on Jetson, +9% grasp
// reliability. One per area.
const FEATURED = ["medical-ai-consulting", "edge-ai-occupancy", "bin-picking-reliability"];
const featured = FEATURED.map((slug) => projects.find((p) => p.slug === slug)!);
const workHref = locale === "it" ? "/it/lavoro/" : "/work/";
---

<section class="wrap py-16 sm:py-20">
  <div class="mb-10 flex items-end justify-between gap-6">
    <div>
      <p class="kicker mb-3">{locale === "it" ? "Lavori selezionati" : "Selected work"}</p>
      <h2 class="display max-w-prose text-2xl sm:text-3xl">
        {locale === "it" ? "Prove, non slide." : "Evidence, not slideware."}
      </h2>
    </div>
    <p class="hidden shrink-0 gap-5 text-sm font-semibold sm:flex">
      <a href="/research/" class="text-accent underline-offset-4 hover:underline">
        {locale === "it" ? "Ricerca →" : "Research →"}
      </a>
      <a href={workHref} class="text-accent underline-offset-4 hover:underline">
        {locale === "it" ? "Tutti i lavori →" : "All work →"}
      </a>
    </p>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    {
      featured.map((p, i) => (
        <article
          data-reveal
          style={`--reveal-delay:${i}`}
          class="flex flex-col rounded-lg border border-line bg-canvas p-6"
        >
          <p class="kicker mb-3 text-accent">{p.category}</p>
          <h3 class="font-serif text-lg leading-snug text-ink">{p.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{pick(p.blurb, locale)}</p>
          <div class="mt-5 border-t border-line pt-4" data-proof>
            <p class="font-mono text-base font-semibold text-ink">{pick(p.proof.value, locale)}</p>
            <p class="mt-1 text-xs leading-relaxed text-faint">{pick(p.proof.label, locale)}</p>
          </div>
          <p class="mt-4 text-sm font-semibold">
            <a
              href={`${workHref}#${p.slug}`}
              class="text-accent underline-offset-4 hover:underline"
            >
              {locale === "it" ? "Leggi il caso" : "Read the case study"}{" "}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </p>
        </article>
      ))
    }
  </div>

  <p class="mt-6 flex gap-5 text-sm font-semibold sm:hidden">
    <a href="/research/" class="text-accent underline-offset-4 hover:underline">
      {locale === "it" ? "Ricerca →" : "Research →"}
    </a>
    <a href={workHref} class="text-accent underline-offset-4 hover:underline">
      {locale === "it" ? "Tutti i lavori →" : "All work →"}
    </a>
  </p>
</section>
