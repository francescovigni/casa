---
// The Italian buyer's entry point: one card per problem, each linking to its
// own service page. Shared by the Italian homepage and /it/servizi/.
import { services } from "../data/services";

interface Props {
  /** The hub page carries its own <h1>, so the section heading goes. */
  heading?: boolean;
}
const { heading = true } = Astro.props;
---

<section id="servizi" class="wrap scroll-mt-24 py-16 sm:py-20">
  {
    heading && (
      <>
        <p class="kicker mb-3">Cosa posso fare per la tua azienda</p>
        <h2 class="display mb-10 max-w-prose text-2xl sm:text-3xl">
          Quattro modi concreti di portare l'AI nei processi.
        </h2>
      </>
    )
  }

  <div class="grid gap-4 md:grid-cols-2">
    {
      services.map((s, i) => (
        <article
          data-reveal
          style={`--reveal-delay:${i}`}
          class="flex flex-col rounded-lg border border-line bg-canvas p-6"
        >
          <h3 class="font-serif text-lg leading-snug text-ink">
            <a href={`/it/servizi/${s.slug}/`} class="hover:text-accent">{s.title}</a>
          </h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{s.blurb}</p>
          <p class="mt-4 text-sm font-semibold">
            <a href={`/it/servizi/${s.slug}/`} class="text-accent underline-offset-4 hover:underline">
              Scopri come <span aria-hidden="true">&rarr;</span>
            </a>
          </p>
        </article>
      ))
    }
  </div>
</section>
