---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Motion from "../components/Motion.astro";
import Analytics from "../components/Analytics.astro";
import Consent from "../components/Consent.astro";
import { localeFromPath, getCounterpart, hasCounterpart, type Locale } from "../i18n";
import { SITE } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Path without locale-agnostic trailing concerns, e.g. "/work/". */
  ogImage?: string;
  /** Keep the page out of search results (the digital business card). */
  noindex?: boolean;
  /** Render the page without site header, footer or skip link. */
  bare?: boolean;
}

const { title, description, ogImage = "/og-default.jpg", noindex = false, bare = false } = Astro.props;
const pathname = Astro.url.pathname;
const locale: Locale = localeFromPath(pathname);
const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(pathname, site).href;
// Only paired routes get hreflang: getCounterpart falls back to the locale
// root, which would tell a crawler that the Italian version of a research
// article is the Italian homepage. A non-reciprocal annotation is worse than
// none, so unpaired pages ship the canonical alone.
const paired = hasCounterpart(pathname);
const enHref = new URL(locale === "en" ? pathname : getCounterpart(pathname, "en"), site).href;
const itHref = new URL(locale === "it" ? pathname : getCounterpart(pathname, "it"), site).href;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {
      paired && (
        <>
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="it" href={itHref} />
          <link rel="alternate" hreflang="x-default" href={enHref} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:locale" content={locale === "it" ? "it_IT" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />

    <Analytics />
    <slot name="head" />
  </head>
  <body>
    {
      bare ? (
        <main id="main">
          <slot />
        </main>
      ) : (
        <>
          <a
            href="#main"
            class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-canvas"
          >
            Skip to content
          </a>
          <Header locale={locale} pathname={pathname} />
          <main id="main">
            <slot />
          </main>
          <Footer locale={locale} />
        </>
      )
    }
    <Motion />
    <Consent locale={locale} />
  </body>
</html>
