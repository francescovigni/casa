---
// On-demand so the geo middleware can redirect Italian IPs to /it/.
export const prerender = false;
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import PersonJsonLd from "../components/PersonJsonLd.astro";
import Pillars from "../components/Pillars.astro";
import Pedigree from "../components/Pedigree.astro";
import Story from "../components/Story.astro";
import Qualifier from "../components/Qualifier.astro";
import Proof from "../components/Proof.astro";
import ResearchTeaser from "../components/ResearchTeaser.astro";
---

<Base
  title="Francesco Vigni, PhD | Applied AI / ML Engineer & Consultant"
  description="Applied AI and ML engineer. I take difficult models from research to production: medical imaging, computer vision, edge AI and robotics, plus the ML infrastructure underneath, and the evidence that says when a model is wrong."
>
  <PersonJsonLd slot="head" locale="en" />

  <Hero locale="en" />
  <Pedigree locale="en" />
  <Pillars locale="en" />
  <Proof locale="en" />
  <ResearchTeaser locale="en" />
  <Story locale="en" limit={2} portrait={false} />
  <Qualifier locale="en" />
</Base>
