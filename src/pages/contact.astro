---
// On-demand so the geo middleware can redirect Italian IPs to /it/contatti/.
export const prerender = false;
import Base from "../layouts/Base.astro";
import Qualifier from "../components/Qualifier.astro";
import Engagement from "../components/Engagement.astro";
import Trust from "../components/Trust.astro";
import { SITE } from "../data/site";
---

<Base
  title="Contact | Applied AI / ML Engineer & Consultant"
  description="Start a conversation about a difficult AI problem: a technical audit, a proof of concept, or ongoing ML support. Medical imaging, computer vision, edge AI and robotics."
>
  <section class="wrap grid gap-10 py-16 sm:py-20 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
    <div>
      <p class="kicker mb-4">Contact</p>
      <h1 class="display text-4xl sm:text-5xl">Get in touch.</h1>
      <p class="lead mt-5 text-lg">
        About a role, a research collaboration, or a scoped project. I reply personally, usually
        within a day or two.
      </p>
      <dl class="mt-8 space-y-4 text-sm">
        <div>
          <dt class="kicker mb-1">Email</dt>
          <dd><a href={`mailto:${SITE.email}`} class="text-ink underline-offset-2 hover:underline">{SITE.email}</a></dd>
        </div>
        <div>
          <dt class="kicker mb-1">Based in</dt>
          <dd class="text-muted">Forlì, Italy · open to relocation & remote</dd>
        </div>
        <div>
          <dt class="kicker mb-1">Elsewhere</dt>
          <dd class="text-muted">
            <a href={SITE.profiles.linkedin} class="hover:text-ink">LinkedIn</a> ·
            <a href={SITE.profiles.scholar} class="hover:text-ink">Scholar</a> ·
            <a href={SITE.profiles.github} class="hover:text-ink">GitHub</a>
          </dd>
        </div>
      </dl>
    </div>

    <Qualifier locale="en" variant="page" />
  </section>

  <Engagement locale="en" />

  <Trust locale="en" />
</Base>
