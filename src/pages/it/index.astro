---
export const prerender = true;
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import PersonJsonLd from "../../components/PersonJsonLd.astro";
import Pillars from "../../components/Pillars.astro";
import Pedigree from "../../components/Pedigree.astro";
import Story from "../../components/Story.astro";
import Qualifier from "../../components/Qualifier.astro";
import Proof from "../../components/Proof.astro";
---

<Base
  title="Francesco Vigni, PhD | Ricercatore e Ingegnere AI"
  description="Ingegnere e ricercatore: costruisco machine learning per imaging medico e robotica, l'infrastruttura per portarlo in produzione, e le prove che dicono quando sbaglia."
>
  <PersonJsonLd slot="head" locale="it" />

  <Hero locale="it" />
  <Pedigree locale="it" />
  <Pillars locale="it" />
  <Proof locale="it" />
  <Story locale="it" limit={2} portrait={false} />
  <Qualifier locale="it" />
</Base>
