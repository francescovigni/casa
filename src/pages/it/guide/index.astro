---
export const prerender = true;
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import PersonJsonLd from "../../../components/PersonJsonLd.astro";

const guides = (await getCollection("guide")).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Guide sull'intelligenza artificiale per le PMI | Francesco Vigni"
  description="Costi di un progetto AI, AI Act e contributi pubblici: risposte chiare alle domande che una PMI si fa prima di portare l'intelligenza artificiale nei propri processi."
>
  <PersonJsonLd slot="head" locale="it" />

  <section class="wrap pt-16 sm:pt-20">
    <p class="kicker mb-4">Guide</p>
    <h1 class="display max-w-prose text-4xl sm:text-5xl">
      L'intelligenza artificiale in azienda, senza fumo.
    </h1>
    <p class="lead mt-5 max-w-prose text-lg">
      Le domande che mi fanno più spesso prima di un progetto, con risposte che puoi usare anche
      se non lavorerai con me.
    </p>
  </section>

  <section class="wrap py-12">
    <div class="grid gap-4 md:grid-cols-3">
      {
        guides.map((g, i) => (
          <article
            data-reveal
            style={`--reveal-delay:${i}`}
            class="flex flex-col rounded-lg border border-line bg-canvas p-6"
          >
            <h2 class="font-serif text-lg leading-snug text-ink">
              <a href={`/it/guide/${g.id}/`} class="hover:text-accent">{g.data.title}</a>
            </h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{g.data.description}</p>
            <p class="mt-4 text-sm font-semibold">
              <a href={`/it/guide/${g.id}/`} class="text-accent underline-offset-4 hover:underline">
                Leggi la guida <span aria-hidden="true">&rarr;</span>
              </a>
            </p>
          </article>
        ))
      }
    </div>
  </section>
</Base>
