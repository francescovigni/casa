---
export const prerender = true;
import Base from "../../../layouts/Base.astro";
import PersonJsonLd from "../../../components/PersonJsonLd.astro";
import Faq from "../../../components/Faq.astro";
import Qualifier from "../../../components/Qualifier.astro";
import { services, type Service } from "../../../data/services";
import { projects } from "../../../data/projects";
import { SITE } from "../../../data/site";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const proof = service.proof.map((slug) => projects.find((p) => p.slug === slug)!);
const others = services.filter((s) => s.slug !== service.slug);
const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.description,
  url: `${SITE.url}/it/servizi/${service.slug}/`,
  provider: { "@id": `${SITE.url}/#person` },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Emilia-Romagna" },
    { "@type": "Country", name: "Italia" },
  ],
  availableLanguage: "it",
};
---

<Base title={service.seoTitle} description={service.description}>
  <PersonJsonLd slot="head" locale="it" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />

  <section class="wrap pt-16 sm:pt-20">
    <p class="kicker mb-4"><a href="/it/servizi/" class="hover:text-ink">Servizi</a></p>
    <h1 class="display max-w-prose text-4xl sm:text-5xl">{service.title}</h1>
    <p class="lead mt-5 max-w-prose text-lg">{service.lead}</p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="/it/contatti/" class="btn-primary">Parliamone <span aria-hidden="true">→</span></a>
      <a href="/it/lavoro/" class="btn-ghost">Il mio lavoro</a>
    </div>
  </section>

  <section class="wrap py-14">
    <h2 class="display mb-6 text-2xl">Fa per te se</h2>
    <ul class="max-w-prose space-y-3">
      {
        service.forWho.map((line) => (
          <li class="flex gap-3 text-base leading-relaxed text-muted">
            <span class="text-accent" aria-hidden="true">✓</span>
            {line}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap pb-14">
    <div class="border-t border-line pt-10">
      <h2 class="display mb-8 text-2xl">Come funziona</h2>
      <ol class="grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-3">
        {
          service.steps.map((step, i) => (
            <li class="bg-canvas p-6" data-reveal style={`--reveal-delay:${i}`}>
              <p class="kicker mb-2 text-accent">{i + 1}</p>
              <h3 class="font-sans text-base font-semibold text-ink">{step.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-sm text-faint">Puoi fermarti dopo ogni passo.</p>
    </div>
  </section>

  <section class="wrap pb-6">
    <div class="border-t border-line pt-10">
      <h2 class="display mb-4 text-2xl">Cosa porto</h2>
      <p class="max-w-prose text-base leading-relaxed text-muted">{service.proofIntro}</p>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {
          proof.map((p) => (
            <a
              href={`/it/lavoro/#${p.slug}`}
              class="block rounded-lg border border-line bg-canvas p-5 transition-colors hover:border-ink"
            >
              <p class="font-serif text-base text-ink">{p.title}</p>
              <p class="mt-3 font-mono text-base font-semibold text-ink">{p.proof.value.it}</p>
              <p class="mt-1 text-xs leading-relaxed text-faint">{p.proof.label.it}</p>
            </a>
          ))
        }
      </div>
      {
        service.more && (
          <p class="mt-5 text-sm font-semibold">
            <a href={service.more.href} hreflang="en" class="text-accent underline-offset-4 hover:underline">
              {service.more.label} <span aria-hidden="true">&rarr;</span>
            </a>
          </p>
        )
      }
    </div>
  </section>

  <Faq items={service.faq} />

  <Qualifier locale="it" />

  <nav class="wrap pb-4" aria-label="Altri servizi">
    <p class="kicker mb-3">Altri servizi</p>
    <ul class="flex flex-col gap-2 text-sm font-semibold sm:flex-row sm:flex-wrap sm:gap-x-6">
      {
        others.map((s) => (
          <li>
            <a href={`/it/servizi/${s.slug}/`} class="text-accent underline-offset-4 hover:underline">
              {s.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Base>
