---
// On-demand so the geo middleware can redirect Italian IPs to /it/lavoro/.
export const prerender = false;
import Base from "../layouts/Base.astro";
import ProjectStory from "../components/ProjectStory.astro";
import CareerArchive from "../components/CareerArchive.astro";
import ResearchCard from "../components/ResearchCard.astro";
import PortfolioNote from "../components/PortfolioNote.astro";
import { projects } from "../data/projects";
import { research } from "../data/research";
---

<Base
  title="Work | Francesco Vigni, PhD"
  description="Selected engineering and research work, each told as a deployment story: context, constraints, what I did, and the outcome. Medical AI, robotics, and infrastructure."
>
  <section class="wrap pt-16 sm:pt-20">
    <p class="kicker mb-4">Selected work</p>
    <h1 class="display max-w-prose text-4xl sm:text-5xl">Evidence, not slideware.</h1>
    <p class="lead mt-5 max-w-prose text-lg">
      Each of these is a real system that had to work under real constraints: context, what
      made it hard, what I did, and what came of it.
    </p>
  </section>

  <!-- Research first: public data, reproducible, negative results left in. The
       deployment stories below are the client work those methods came out of. -->
  <section class="wrap pt-8">
    <div class="mb-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t border-line pt-7">
      <h2 class="display text-2xl">Research, on public data</h2>
      <a class="link-underline text-sm font-medium text-accent" href="/research/">
        All research &rarr;
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-2 md:gap-7">
      {research.map((study, i) => <ResearchCard study={study} index={i} level={3} />)}
    </div>
    <PortfolioNote variant="inline" />
  </section>

  <section class="wrap pb-8 pt-10">
    <h2 class="display mb-2 border-t border-line pt-7 text-2xl">Deployment stories</h2>
    {projects.map((project) => <ProjectStory project={project} locale="en" />)}
  </section>

  <CareerArchive locale="en" />
</Base>
